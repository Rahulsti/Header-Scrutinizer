{
    "manifest_version": 3,
    "name": "Secure Headers Scrutinizer",
    "version": "1.0",
    "description": "Checks key security headers (CSP, HSTS, X-Frame-Options) on the current tab.",
    "permissions": [
        "webRequest",
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        }
    }
}